<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:MachineApplication.Entrance.Models"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <!--  模板按节点类型递归应用；每一级只负责自己的缩进与展开状态。  -->
        <DataTemplate DataType="{x:Type models:NavModel}">
            <StackPanel>
                <Button
                    MinHeight="46"
                    Margin="0,3,8,3"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.ActivateNavigationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Title}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Row"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="0,24,24,0">
                                            <Grid>
                                                <Border
                                                    x:Name="Highlight"
                                                    Background="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                    CornerRadius="0,24,24,0"
                                                    Opacity="0" />
                                                <Grid Margin="14,8,8,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                        Kind="{Binding Icon}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <materialDesign:PackIcon
                                                        x:Name="Chevron"
                                                        Grid.Column="2"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Kind="ChevronRight"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BooleanVisibility}}" />

                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Highlight" Property="Opacity" Value="0" />
                                                <Setter Property="FontWeight" Value="SemiBold" />

                                            </DataTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <ItemsControl
                    Margin="12,0,0,0"
                    ItemsSource="{Binding Children}"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </ResourceDictionary>
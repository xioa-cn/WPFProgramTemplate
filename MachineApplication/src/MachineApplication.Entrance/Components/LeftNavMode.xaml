<UserControl
    x:Class="MachineApplication.Entrance.Components.LeftNavMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
    design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:MachineApplication.Entrance.Models"
    xmlns:vm="clr-namespace:MachineApplication.Entrance.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    d:DesignHeight="580"
    d:DesignWidth="240"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
    BorderThickness="0,0,1,0"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="/MachineApplication.Entrance;component/Components/NavigationResources.xaml" />
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <!--  选中背景与箭头同处滚动区外；先铺实色底，跨越左右背景时不会出现色差。  -->
        <Canvas ClipToBounds="False" IsHitTestVisible="False">
            <!-- 悬停背景统一从侧栏左边缘绘制，不受子菜单缩进影响。 -->
            <Border x:Name="HoverBackground" Visibility="Collapsed" CornerRadius="0,24,24,0"
                    Background="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.08" />
            <Border
                x:Name="SelectionBackground"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                CornerRadius="0,24,24,0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SelectionBackgroundPosition" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.10"
                        ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <!--  以 24% 的主色叠加在主题表面上，加强选中背景的辨识度。  -->
                    <Border
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="0,24,24,0"
                        Opacity="0.55" />
                    <Border
                        BorderBrush="#20FFFFFF"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,24,24,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#12FFFFFF" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </Canvas>
        <Grid Margin="0,22,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="ToggleNavigationButton" Width="40" Height="40" Padding="0"
                        Command="{Binding ToggleNavigationCommand}"
                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="ToolTip"
                                    Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_CollapseNavigation}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                    <Setter Property="ToolTip"
                                            Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_ExpandNavigation}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Width="22" Height="22">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="ChevronLeft" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                        <Setter Property="Kind" Value="Menu" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
                <TextBlock Grid.Column="0" Margin="6,0,8,0" VerticalAlignment="Center"
                           FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Navigation}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <!--  Hidden 隐藏滚动条且不占宽度，同时保留纵向滚动能力。  -->
            <ScrollViewer
                x:Name="MenuViewport"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                Style="{StaticResource MaterialDesignScrollViewer}"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding NavigationItems}" />
            </ScrollViewer>

        </Grid>
        <!--  放在滚动区外，使箭头可以越过侧栏边界；位置由视图布局逻辑同步。  -->
        <Border
            x:Name="SelectionArrow"
            Width="36"
            Height="36"
            Margin="0,0,-16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource MaterialDesign.Brush.Primary}"
            CornerRadius="18"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SelectionArrowPosition" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Opacity="0.16"
                    ShadowDepth="2" />
            </Border.Effect>
            <materialDesign:PackIcon
                Width="21"
                Height="21"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                Kind="ArrowRight" />
        </Border>
    </Grid>
</UserControl>
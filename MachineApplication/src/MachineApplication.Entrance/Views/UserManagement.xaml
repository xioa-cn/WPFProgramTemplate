<UserControl x:Class="MachineApplication.Entrance.Views.UserManagement"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:permissions="clr-namespace:Machine.ModuleLoad.Mapper;assembly=Machine.ModuleLoad"
 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="用户管理" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <Grid Grid.Row="1" Margin="0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel>
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
       <Button Content="新增" Command="{Binding NewUserCommand}" Margin="0,0,8,0"/>
       <Button Content="删除" Command="{Binding DeleteUserCommand}"/>
      </WrapPanel>
      <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Name"/>
     </DockPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="账号"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
      <TextBlock Text="密码（修改账号时留空表示不变）"/><PasswordBox x:Name="NewPassword" Margin="0,4,0,16"/>
      <TextBlock Text="权限等级（最高权限账号无需选择）"/>
      <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding UserLevel}" DisplayMemberPath="Name" Margin="0,4,0,20"/>
      <Button Content="保存账号" Click="SaveUserClick" HorizontalAlignment="Left"/>
     </StackPanel>
    </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </Grid>
</UserControl>
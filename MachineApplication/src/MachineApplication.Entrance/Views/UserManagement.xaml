<UserControl x:Class="MachineApplication.Entrance.Views.UserManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MachineApplication.Entrance.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=viewModels:UserManagementViewModel}" mc:Ignorable="d"
             xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
             xmlns:viewModels="clr-namespace:MachineApplication.Entrance.ViewModels"
             design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <md:DialogHost IsOpen="{Binding IsEditorOpen}" CloseOnClickAway="False">
        <md:DialogHost.DialogContent>
            <views:UserEditorDialog />
        </md:DialogHost.DialogContent>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="＋ 新增用户" Command="{Binding NewUserCommand}"
                        VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="用户管理" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="维护登录账号、密码和权限等级" Margin="0,8,0,0" Opacity=".65" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Padding="16" CornerRadius="8"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Margin="0,0,0,16">
                <TextBlock Text="普通用户需分配权限等级。最高权限账号不能删除或重命名，修改密码时留空表示保持原密码。" TextWrapping="Wrap" Opacity=".75" />
            </Border>
            <Border Grid.Row="2" BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding ReloadCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" />
                        <TextBlock Text="{Binding Users.Count, StringFormat=共 {0} 个用户}" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeight="60" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="账号名称" Width="*">
    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                       Margin="16,0" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="权限等级" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Margin="16,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding Level.Name, TargetNullValue=未分配}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                            <Setter Property="Text" Value="最高权限" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑" Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Users.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="暂无用户" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角「新增用户」创建账号" Margin="0,12,0,0" Opacity=".65" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="22" />
        </Grid>
    </md:DialogHost>
</UserControl>
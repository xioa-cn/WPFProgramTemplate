<Page x:Class="MachineApplication.Entrance.Views.SuperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:MachineApplication.Entrance.ViewModels"
      xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
      design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
      d:DataContext="{d:DesignInstance Type=vm:SuperViewModel}"
      mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="960"
      Title="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Title}"
      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsSelect" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8" />
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8" />
        </Style>
        <Style x:Key="DetailsHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Highlight" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            <Border x:Name="FocusOutline" CornerRadius="6" BorderThickness="1" Opacity="0"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Grid Margin="8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                             Margin="0,0,10,0" Opacity="0.65" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Content"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <md:PackIcon x:Name="Arrow" Grid.Column="2" Kind="ChevronDown"
                                             Width="16" Height="16" Margin="12,0,0,0" Opacity="0.6"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Kind" Value="ChevronUp" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.04" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.08" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineDetails" TargetType="Expander">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderThickness="0,1,0,0" Padding="0,6,0,0"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource DetailsHeader}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                        </DataTemplate>
                                    </ToggleButton.ContentTemplate>
                                </ToggleButton>
                                <ContentPresenter x:Name="DetailsContent" ContentSource="Content"
                                                  Margin="34,2,12,10" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusMessage" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                </DataTrigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel Margin="24,24,24,6">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Border CornerRadius="13" Background="{DynamicResource MaterialDesign.Brush.Primary}" Opacity="0.1" />
                        <md:PackIcon Kind="Tune" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Title}" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Subtitle}" Style="{StaticResource FieldHint}" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource SettingsCard}" Padding="16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <md:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,2,8,4"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="appSettings.json" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,4" />
                            <Border CornerRadius="5" Padding="8,3" Background="{DynamicResource MaterialDesign.Brush.Background}" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RestartRequired}" FontSize="11" Opacity="0.7" />
                            </Border>
                        </WrapPanel>
                        <TextBox Text="{Binding ConfigurationPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"
                                 ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConfigurationHint}"
                                 AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConfigurationPath}" />
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConfigurationSummary}" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <md:PackIcon Kind="TextBoxOutline" Width="21" Height="21" Margin="0,1,10,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_LoggingSettings}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ActiveProviderText}" Style="{StaticResource FieldHint}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Provider}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider, Mode=TwoWay}"
                                          Style="{StaticResource SettingsSelect}" AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Provider}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ProviderHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_MinimumLevel}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel, Mode=TwoWay}"
                                          Style="{StaticResource SettingsSelect}" AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_MinimumLevel}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_MinimumLevelHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource MaterialDesign.Brush.Separator.Background}" Margin="0,22" />
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_StorageTitle}" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,18" />
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_LogDirectory}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"
                                 AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_LogDirectory}" />
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_LogDirectoryHint}" Style="{StaticResource FieldHint}" />
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_FileSizeLimit}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FileSizeLimitBytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"
                                         AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_FileSizeLimitName}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_FileSizeLimitHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RetainedFileCount}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RetainedFileCountLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"
                                         AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RetainedFileCount}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RetainedFileCountHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <md:PackIcon Kind="ConsoleLine" Width="21" Height="21" Margin="0,1,10,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConsoleTitle}" Style="{StaticResource SectionTitle}" />
                        </Grid>
                        <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConsoleSummary}" Style="{StaticResource FieldHint}" Margin="0,0,0,16" />
                        <Border Background="{DynamicResource MaterialDesign.Brush.Background}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConsoleOpen}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Growl.Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding ConsoleStatusText}" TextWrapping="Wrap" FontSize="12" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Command="{Binding OpenConsoleCommand}" Margin="0,0,8,4" Style="{StaticResource OutlineButton}"
                                            Content="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_OpenConsole}" />
                                    <Button Command="{Binding CloseConsoleCommand}" Margin="0,0,0,4" IsEnabled="{Binding IsConsoleOpen}"
                                            Style="{StaticResource QuietButton}" Content="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_CloseConsole}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ConsoleMessage}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsoleHasError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Expander Header="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConsoleDetails}"
                                  Style="{StaticResource InlineDetails}" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ConsoleHint}"
                                       Style="{StaticResource FieldHint}" Margin="0" LineHeight="20" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="0,1,0,0"
                Padding="24,14,24,10">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}"
                            Style="{StaticResource QuietButton}" ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_RestoreDefaultsHint}" Margin="0,0,8,4" />
                    <Button Content="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Reload}" Command="{Binding ReloadCommand}"
                            Style="{StaticResource OutlineButton}" ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_ReloadHint}" Margin="0,0,8,4" />
                    <Button Command="{Binding SaveCommand}" Height="38" Padding="16,0" Margin="0,0,0,4"
                            Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8"
                            AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Save}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=SuperPage_Save}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

<Window x:Class="MachineApplication.Entrance.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MachineApplication.Entrance.ViewModels"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_LoginTitle}"
        Width="1120" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#20263E" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <Style x:Key="LoginCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#535E7A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#A5AEC5"
                                        BorderThickness="1.3" Background="White" VerticalAlignment="Center">
                                    <Path x:Name="Tick" Data="M3,8 L6,11 12,4" Stroke="White" StrokeThickness="1.8"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#394EEB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#394EEB" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="#8195F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DEE2EF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" /><Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="14,8" /><Setter Property="Height" Value="52" />
        </Style>
    </Window.Resources>
    <Grid Background="{x:Null}" PreviewMouseLeftButtonDown="DragWindow">
        <Border Margin="12,12,145,12" CornerRadius="24" Background="#F1F4FC" BorderBrush="White" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity=".15" Color="#546491" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="22" Padding="46,34">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Background="#394EEB" CornerRadius="7" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="MachineApplication" FontWeight="SemiBold" FontSize="22"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Heading}"
                                FontSize="32" FontWeight="Bold" />
                            <TextBlock
                                Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Subtitle}"
                                Foreground="#778096" Margin="0,8,0,28" TextWrapping="Wrap" />
                            <StackPanel x:Name="Form">
                                <TextBlock
                                    Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Account}"
                                    Margin="0,0,0,6" />
                                <Border Style="{StaticResource Field}">
                                    <DockPanel>
                                        <md:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#8691AE"
                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox x:Name="Account" Style="{x:Null}" BorderThickness="0"
                                                 Background="Transparent" Foreground="#20263E" FontSize="15"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Account}" />
                                    </DockPanel>
                                </Border>
                                <TextBlock
                                    Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Password}"
                                    Margin="0,16,0,6" />
                                <Border Style="{StaticResource Field}">
                                    <DockPanel>
                                        <md:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#8691AE"
                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <PasswordBox x:Name="Password" Style="{x:Null}" BorderThickness="0"
                                                     Background="Transparent" Foreground="#20263E" FontSize="15"
                                                     VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Password}" />
                                    </DockPanel>
                                </Border>
                                <WrapPanel Margin="0,18,0,0">
                                    <CheckBox Style="{StaticResource LoginCheckBox}" x:Name="Remember"
                                              Content="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Remember}"
                                              Foreground="#535E7A" Margin="0,0,20,8" Checked="PreferencesChanged"
                                              Unchecked="PreferencesChanged" />
                                    <CheckBox Style="{StaticResource LoginCheckBox}" x:Name="Automatic"
                                              Content="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Automatic}"
                                              Foreground="#535E7A" Checked="PreferencesChanged"
                                              Unchecked="PreferencesChanged" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock x:Name="Error" Foreground="#CC4056" TextWrapping="Wrap" MinHeight="32"
                                       Margin="0,6,0,8" />
                            <Grid Height="48">
                                <Button x:Name="Submit"
                                        Content="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Login}"
                                        Background="#394EEB" Foreground="White" BorderThickness="0" FontSize="16"
                                        FontWeight="SemiBold" Height="48" IsDefault="True" Click="LoginClick"
                                        md:ButtonAssist.CornerRadius="8" />
                                <Border x:Name="Busy" Background="#394EEB" CornerRadius="8" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     Width="22"
                                                     Height="22" Foreground="White" Margin="0,0,12,0" />
                                        <TextBlock
                                            Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Busy}"
                                            Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_Footer}"
                                   Foreground="#8790A8" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" CornerRadius="0,22,22,0">
                    <Border.Background>
                        <RadialGradientBrush Center=".55,.5" RadiusX=".8" RadiusY=".65">
                            <GradientStop Color="#DCE4FF" /><GradientStop Color="#F1F5FC" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Bottom" Margin="26,0,26,40">
                            <TextBlock
                                Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_VisualSubtitle}"
                                Foreground="#7F8AB9" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Login_VisualTitle}"
                                Foreground="#384878" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                                TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>

                    </Grid></Border>
                    
            </Grid>
        </Border>
        <!-- 独立矢量浮层：右侧透明窗口区域承接越过卡片边缘的轨道。 -->
        <Viewbox Width="620" Height="460" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,4,28" IsHitTestVisible="False">
            <Canvas Width="680" Height="510">
                <Canvas.Resources>
                    <LinearGradientBrush x:Key="CloudDepth" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DAE8FF"/><GradientStop Color="#658AFF" Offset=".35"/>
                        <GradientStop Color="#294FE6" Offset=".7"/><GradientStop Color="#7FB5FF" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="CloudFace" StartPoint=".05,.1" EndPoint=".9,.85">
                        <GradientStop Color="#F1F6FF"/><GradientStop Color="#BACDFF" Offset=".16"/>
                        <GradientStop Color="#809EFF" Offset=".4"/><GradientStop Color="#4469EE" Offset=".72"/>
                        <GradientStop Color="#BDDFFF" Offset="1"/>
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="Pearl" Center=".32,.24" GradientOrigin=".22,.16" RadiusX=".8" RadiusY=".8">
                        <GradientStop Color="White"/><GradientStop Color="#DFEBFF" Offset=".25"/>
                        <GradientStop Color="#9FB7ED" Offset=".65"/><GradientStop Color="#F5FAFF" Offset="1"/>
                    </RadialGradientBrush>
                    <LinearGradientBrush x:Key="OrbitBand" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF"/><GradientStop Color="#CFDCFD" Offset=".45"/>
                        <GradientStop Color="#7090E7" Offset="1"/>
                    </LinearGradientBrush>
                </Canvas.Resources>
                <!-- 底部柔影和分层椭圆底座。 -->
                <Path Fill="#657FD0" Opacity=".25" Data="M125,423 C125,387 528,377 564,417 C604,463 186,483 125,423Z">
                    <Path.Effect><BlurEffect Radius="24"/></Path.Effect>
                </Path>
                <Path Data="M224,388 C249,346 450,341 484,381 L484,405 C463,451 251,456 224,411Z" Stroke="#C0CFF4">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E7EFFF"/><GradientStop Color="White" Offset=".35"/><GradientStop Color="#A5B8EC" Offset="1"/></LinearGradientBrush></Path.Fill>
                </Path>
                <Path Data="M224,387 C220,343 473,337 485,383 C493,427 235,439 224,387Z" Fill="#F1F5FF" Stroke="White" StrokeThickness="2"/>
                <Path Data="M272,365 C275,342 427,335 442,358 C455,384 290,398 272,365Z" Fill="#9EBFFD" Stroke="#E3F2FF" StrokeThickness="3"/>
                <!-- 轨道后半圈先绘制，后续云体遮挡形成真实前后层次。 -->
                <Path Data="M56,287 C-26,133 440,17 611,91 C743,148 568,314 402,369"
                      Stroke="#ACBEEB" StrokeThickness="2" Fill="{x:Null}"/>
                <Path Data="M55,286 C-24,136 438,22 610,93 C737,150 568,310 402,367"
                      Stroke="White" StrokeThickness="2" Fill="{x:Null}"/>
                <Path Data="M163,95 C408,-9 664,241 581,398" Stroke="#B9CAF7" StrokeThickness="1.6" Fill="{x:Null}"/>
                <!-- 后层轮廓向右上偏移，表现云体厚度。 -->
                <Path Data="M228,333 C147,318 144,215 211,193 C203,112 260,49 334,63 C385,70 417,109 433,157 C506,142 557,203 552,264 C548,330 491,364 429,354Z"
                      Fill="{StaticResource CloudDepth}" Stroke="#B1C9FF" StrokeThickness="2">
                    <Path.Effect><DropShadowEffect Color="#365BC7" BlurRadius="22" ShadowDepth="14" Opacity=".3"/></Path.Effect>
                </Path>
                <!-- 前层使用连续贝塞尔曲线和渐变，避免单色平面图标感。 -->
                <Path Data="M204,350 C126,330 127,231 194,207 C183,134 236,85 300,99 C358,110 383,154 391,200 C455,179 510,226 512,282 C515,342 460,386 404,372Z"
                      Fill="{StaticResource CloudFace}" Stroke="#EAF3FF" StrokeThickness="3"/>
                <Path Data="M194,207 C184,137 237,85 300,99 C348,107 378,145 390,196"
                      Stroke="#FFFFFF" StrokeThickness="5" Opacity=".66" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M152,255 C145,300 164,334 203,348 L403,370 C440,380 474,358 493,330"
                      Stroke="#B5DAFF" StrokeThickness="4" Opacity=".6" StrokeStartLineCap="Round"/>
                <!-- 网络连接线与高光节点。 -->
                <Path Data="M139,151 L231,112 405,72 509,152 560,265 M139,151 L183,274 322,217 363,305 477,288 M183,274 L278,348 322,217 231,112 M278,348 L363,305 477,288 509,152 M322,217 L509,152 M405,72 L420,181"
                      Stroke="#EDF5FF" StrokeThickness="1.8" Opacity=".9" Fill="{x:Null}"/>
                <!-- 前半圈加宽为金属带，越过云体与卡片边缘。 -->
                <Path Data="M57,286 C31,325 91,367 223,371 C397,374 587,270 626,188
                            C596,282 405,391 225,389 C75,389 20,342 57,286Z"
                      Fill="{StaticResource OrbitBand}" Stroke="#EAF1FF" StrokeThickness="1.2"/>
                <Path Data="M57,286 C31,325 91,367 223,371 C397,374 587,270 626,188"
                      Stroke="White" StrokeThickness="3" Fill="{x:Null}"/>
                <Path Data="M172,394 C30,468 483,516 604,399 C650,355 586,303 551,290"
                      Stroke="#98B2F5" StrokeThickness="3" Fill="{x:Null}"/>
                <Path Data="M173,391 C30,465 483,512 603,396 C647,354 586,306 551,292"
                      Stroke="#F8FBFF" StrokeThickness="2" Fill="{x:Null}"/>
                <Path Fill="{StaticResource Pearl}" Stroke="#B0C1EE" StrokeThickness="1.4">
                    <Path.Data><GeometryGroup>
                        <EllipseGeometry Center="139,151" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="231,112" RadiusX="9" RadiusY="10"/>
                        <EllipseGeometry Center="405,72" RadiusX="10" RadiusY="11"/>
                        <EllipseGeometry Center="509,152" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="183,274" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="322,217" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="363,305" RadiusX="10" RadiusY="11"/>
                        <EllipseGeometry Center="278,348" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="477,288" RadiusX="10" RadiusY="11"/>
                        <EllipseGeometry Center="549,437" RadiusX="13" RadiusY="14"/>
                    </GeometryGroup></Path.Data>
                </Path>
                <Path Fill="{StaticResource CloudDepth}" Stroke="#DBEDFF" StrokeThickness="2">
                    <Path.Data><GeometryGroup>
                        <EllipseGeometry Center="66,277" RadiusX="11" RadiusY="12"/>
                        <EllipseGeometry Center="592,148" RadiusX="9" RadiusY="10"/>
                    </GeometryGroup></Path.Data>
                </Path>
            </Canvas>
        </Viewbox>
        <!-- 顶层关闭按钮不受插画和主题按钮默认内边距影响。 -->
        <Button x:Name="CloseButton" Panel.ZIndex="10" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,24,157,0" Width="36" Height="36"
                Padding="0" Click="CloseClick" Cursor="Hand"
                ToolTip="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}"
                AutomationProperties.Name="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#667396"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FCE6EB"/>
                                        <Setter Property="Foreground" Value="#C33350"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#F4C9D3"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Surface" Property="BorderBrush" Value="#8195F4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
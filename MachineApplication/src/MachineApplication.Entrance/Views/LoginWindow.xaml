<Window x:Class="MachineApplication.Entrance.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号登录" Width="380" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <StackPanel Margin="28">
        <TextBlock Text="登录工作空间" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Text="账号" /><TextBox x:Name="Account" Margin="0,4,0,16" />
        <TextBlock Text="密码" /><PasswordBox x:Name="Password" Margin="0,4,0,16" />
        <TextBlock x:Name="Error" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Button x:Name="Submit" Content="登录" IsDefault="True" Click="LoginClick" />
    </StackPanel>
</Window>
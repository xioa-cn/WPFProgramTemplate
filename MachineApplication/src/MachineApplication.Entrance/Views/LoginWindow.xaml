<Window x:Class="MachineApplication.Entrance.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MachineApplication.Entrance.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_LoginTitle}" Width="380" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <StackPanel Margin="28">
        <TextBlock Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_LoginHeading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Account}" /><TextBox x:Name="Account" Margin="0,4,0,16" />
        <TextBlock Text="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Password}" /><PasswordBox x:Name="Password" Margin="0,4,0,16" />
        <TextBlock x:Name="Error" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Button x:Name="Submit" Content="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_Login}" IsDefault="True" Click="LoginClick" />
    </StackPanel>
</Window>
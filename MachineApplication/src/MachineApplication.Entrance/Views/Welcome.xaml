<Page x:Class="MachineApplication.Entrance.Views.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MachineApplication.Entrance.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
      design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
      d:DataContext="{d:DesignInstance Type=vm:WelcomeViewModel}" mc:Ignorable="d"
      Title="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Welcome_Title}"
      Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <Page.Resources>
        <LinearGradientBrush x:Key="BlueCloud" StartPoint=".15,0" EndPoint=".8,1">
            <GradientStop Color="#C2FFF4" /><GradientStop Color="#28CFD7" Offset=".25" />
            <GradientStop Color="#5CB8FF" Offset=".58" /><GradientStop Color="#3B6BEC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WhiteCloud" StartPoint="0,0" EndPoint="1,.8">
            <GradientStop Color="#C5E6FA" /><GradientStop Color="#FFFFFF" Offset=".32" />
            <GradientStop Color="#ECF5FF" Offset=".65" /><GradientStop Color="#B4CEF4" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="MintSphere" GradientOrigin=".25,.18" Center=".3,.25" RadiusX=".85" RadiusY=".85">
            <GradientStop Color="#EDFFF1" /><GradientStop Color="#7EE7D3" Offset=".4" />
            <GradientStop Color="#04C2C5" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PurpleSphere" GradientOrigin=".2,.16" Center=".3,.25" RadiusX=".9" RadiusY=".9">
            <GradientStop Color="#F1EBFF" /><GradientStop Color="#B4A5EF" Offset=".45" />
            <GradientStop Color="#8A72E6" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Pearl" GradientOrigin=".2,.15" RadiusX=".8" RadiusY=".8">
            <GradientStop Color="White" /><GradientStop Color="#D3EEFA" Offset=".4" />
            <GradientStop Color="#6DB7DD" Offset="1" />
        </RadialGradientBrush>
    </Page.Resources>
    <Grid ClipToBounds="True">

        <!-- 使用统一设计坐标等比缩放，避免窗口变化时文案与插画互相覆盖。 -->
        <Viewbox Stretch="Uniform" Margin="24">
            <Grid Width="1200" Height="650">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520" /><ColumnDefinition Width="680" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="48,0,0,0">
                    <TextBlock Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Welcome_Title}"
                               FontSize="54" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Welcome_Subtitle}"
                        FontSize="20" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity=".75"
                        TextWrapping="Wrap" LineHeight="32" Margin="0,20,0,32" />
                    <Button Content="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Welcome_Enter}"
                            Command="{Binding EnterWorkspaceCommand}" HorizontalAlignment="Left"
                            Padding="36,15" FontSize="19" Cursor="Hand" MinWidth="190">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Surface" CornerRadius="32"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity=".1"
                                                                      Color="#637B95" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Surface" Property="BorderBrush"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value=".5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" TextWrapping="Wrap"
                               Margin="0,18,0,0" FontSize="14" />
                </StackPanel>
                <!-- 纯 Path 插画，云体前后分层并通过渐变表现厚度。 -->
                <Canvas Grid.Column="1" Width="680" Height="580" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="M100,475 C160,421 545,430 612,494 C652,552 187,571 100,475Z" Fill="#C5D8E8"
                          Opacity=".48">
                        <Path.Effect>
                            <BlurEffect Radius="30" />
                        </Path.Effect>
                    </Path>
                    <!-- 背后悬浮信息卡。 -->
                    <Path Data="M483,66 Q480,50 498,58 L647,105 Q658,109 656,125 L641,242 Q639,252 627,248 L474,197Z"
                          Fill="#EFFAFF" Stroke="#BCDCEB" StrokeThickness="3" />
                    <Path Data="M499,101 L614,137" Stroke="#E0EAF8" StrokeThickness="7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="M499,101 L571,124" Stroke="#90AEEA" StrokeThickness="7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="M494,139 L603,172" Stroke="#70DADD" StrokeThickness="7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="M554,322 L670,247" Stroke="#19B4B6" StrokeThickness="2" />
                    <Path Stroke="#19B4B6" StrokeThickness="2" Fill="#FAFFFF">
                        <Path.Data>
                            <EllipseGeometry Center="670,247" RadiusX="10" RadiusY="11" />
                        </Path.Data>
                    </Path>
                    <Path Fill="{StaticResource MintSphere}">
                        <Path.Data>
                            <EllipseGeometry Center="186,109" RadiusX="48" RadiusY="50" />
                        </Path.Data>
                    </Path>
                    <!-- 大云后侧轮廓。 -->
                    <Path
                        Data="M287,209 C280,126 331,107 384,98 C459,80 491,142 505,188 C586,193 611,265 596,337 C588,389 548,423 499,421 L302,366 C242,339 240,246 287,209Z"
                        Fill="{StaticResource BlueCloud}" Stroke="#9FE8ED" StrokeThickness="2" />
                    <Path
                        Data="M222,221 C225,142 272,110 319,120 C376,130 399,173 408,213 C474,214 503,282 502,335 C499,408 464,446 419,449 L251,408 C168,397 156,253 222,221Z"
                        Fill="{StaticResource BlueCloud}" Stroke="#5CBCE9" StrokeThickness="3">
                        <Path.Effect>
                            <DropShadowEffect Color="#5686C9" BlurRadius="18" ShadowDepth="10" Opacity=".2" />
                        </Path.Effect>
                    </Path>
                    <Path Data="M223,220 C226,145 273,111 319,120 C370,130 393,170 407,212"
                          Stroke="#D1FFF9" StrokeThickness="3" Fill="{x:Null}" />
                    <!-- 前方白云的厚度。 -->
                    <Path
                        Data="M144,290 C151,233 200,204 242,214 C287,224 309,256 317,297 C372,291 400,349 389,402 C385,448 354,477 309,487 L156,447 C86,425 89,328 144,290Z"
                        Fill="{StaticResource WhiteCloud}" Stroke="#EAF6FF" StrokeThickness="2" />
                    <Path
                        Data="M115,307 C112,244 157,220 191,233 C235,242 250,276 259,312 C311,302 343,354 343,401 C344,449 318,489 289,494 L124,451 C65,427 60,337 115,307Z"
                        Fill="{StaticResource WhiteCloud}" Stroke="#F8FDFF" StrokeThickness="3" />
                    <Path Data="M115,307 C111,251 151,221 191,233 C229,244 250,278 259,312"
                          Stroke="White" StrokeThickness="4" Opacity=".85" />
                    <Path Data="M91,361 C75,395 95,433 124,449 L286,492"
                          Stroke="#CEE9F4" StrokeThickness="5" Opacity=".7" />
                    <!-- 前景连接与球体。 -->
                    <Path Data="M69,477 L174,412 181,341 M174,412 L241,442" Stroke="#418FCC" StrokeThickness="2.5"
                          Fill="{x:Null}" />
                    <Path Fill="{StaticResource Pearl}" Stroke="White" StrokeThickness="1.3">
                        <Path.Data>
                            <GeometryGroup>
                                <EllipseGeometry Center="181,341" RadiusX="14" RadiusY="15" />
                                <EllipseGeometry Center="174,412" RadiusX="14" RadiusY="15" />
                                <EllipseGeometry Center="241,442" RadiusX="14" RadiusY="15" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <Path Fill="{StaticResource BlueCloud}">
                        <Path.Data>
                            <EllipseGeometry Center="51,487" RadiusX="14" RadiusY="15" />
                        </Path.Data>
                    </Path>
                    <Path Fill="{StaticResource PurpleSphere}">
                        <Path.Data>
                            <EllipseGeometry Center="584,467" RadiusX="56" RadiusY="58" />
                        </Path.Data>
                    </Path>
                </Canvas>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
<UserControl x:Class="MachineApplication.Entrance.Views.PermissionSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MachineApplication.Entrance.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=viewModels:PermissionSettingsViewModel}" mc:Ignorable="d"
             xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
             xmlns:viewModels="clr-namespace:MachineApplication.Entrance.ViewModels"
             design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources>
        <Style x:Key="PermissionCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <md:DialogHost IsOpen="{Binding IsEditorOpen}" CloseOnClickAway="False">
        <md:DialogHost.DialogContent>
            <views:PermissionLevelDialog />
        </md:DialogHost.DialogContent>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="＋ 新增等级" Command="{Binding NewLevelCommand}"
                        VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="权限等级" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="统一维护账号可分配的权限等级" Margin="0,8,0,0" Opacity=".65" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Padding="16" CornerRadius="8"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Margin="0,0,0,16">
                <TextBlock Text="等级仅用于身份分类，页面访问范围请在「路由配置」中设置。已关联账号的等级无法删除。" TextWrapping="Wrap" Opacity=".75" />
            </Border>
            <Border Grid.Row="2" BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding ReloadCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" />
                        <TextBlock Text="{Binding Levels.Count, StringFormat=已配置 {0} 个等级}" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeight="60" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="等级名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource PermissionCellText}" />
                            <DataGridTextColumn Header="排序值" Binding="{Binding Rank}" Width="100" ElementStyle="{StaticResource PermissionCellText}" />
                            <!-- <DataGridTextColumn Header="等级 ID" Binding="{Binding Id}" Width="100" ElementStyle="{StaticResource PermissionCellText}" /> -->
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑" Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.EditLevelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.DeleteLevelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Levels.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="尚未配置权限等级" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角「新增等级」开始配置" Margin="0,12,0,0" Opacity=".65" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="22" />
        </Grid>
    </md:DialogHost>
</UserControl>
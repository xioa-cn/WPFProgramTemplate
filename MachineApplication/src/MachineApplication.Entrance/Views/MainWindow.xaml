<Window
    x:Class="MachineApplication.Entrance.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MachineApplication.Entrance.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
    design:ViewDesignInclude.Source="/MachineApplication.Entrance;component/AppResources.xaml"
    xmlns:components="clr-namespace:MachineApplication.Entrance.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApplication.Entrance.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:region="clr-namespace:Machine.ModuleLoad.Region;assembly=Machine.ModuleLoad"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:MachineApplication.Entrance.ViewModels"
    Title="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Global_AppName}"
    Width="1040"
    Height="640"
    MinWidth="640"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    BorderThickness="0"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    FontSize="14"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <!--  系统非客户区负责拖动、双击最大化和边缘缩放，无需鼠标事件。  -->
        <shell:WindowChrome
            CaptionHeight="70"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="/MachineApplication.Entrance;component/Theme/MainWindowResources.xaml" />
    </Window.Resources>
    <AdornerDecorator>
        <Border
            Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
            BorderThickness="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  标题栏跟随主题主色，波纹揭开旧截图时可见整条标题栏逐步换色。  -->
                <Border
                    x:Name="ThemeTitleBar"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                    <Grid Margin="16,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  轻微顶部反光保留主色，避免整条标题栏呈现生硬的纯色块。  -->
                        <Border
                            Grid.ColumnSpan="2"
                            Margin="-16,0,-6,0"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#22FFFFFF" />
                                    <GradientStop Offset="0.65" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#08000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,12,0"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Kind="ViewDashboardOutline" />
                            <TextBlock
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                x:Name="ThemeButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_ThemeColor}"
                                Command="{Binding ShowThemeColorsCommand}"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_ThemeColor}">
                                <materialDesign:PackIcon
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                    Kind="PaletteOutline" />
                            </Button>
                            <Button
                                x:Name="PinButton"
                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Command="{x:Static local:WindowCommands.ToggleTopmost}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="ToolTip"
                                                Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Pin}" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                                <Setter Property="ToolTip"
                                                        Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Unpin}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="Pin" />
                            </Button>
                            <Border
                                Width="1"
                                Height="16"
                                Margin="8,0"
                                Background="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Opacity="0.25" />
                            <Button
                                x:Name="MinimizeButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Minimize}"
                                Command="{x:Static local:WindowCommands.Minimize}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Minimize}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="WindowMinimize" />
                            </Button>
                            <Button
                                x:Name="MaximizeButton"
                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Command="{x:Static local:WindowCommands.ToggleMaximize}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="ToolTip"
                                                Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Maximize}" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized">
                                                <Setter Property="ToolTip"
                                                        Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Restore}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="17" Height="17">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="WindowMaximize" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="Maximized">
                                                    <Setter Property="Kind" Value="WindowRestore" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button
                                x:Name="CloseButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}"
                                Command="{x:Static local:WindowCommands.Close}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="Template" Value="{StaticResource CloseButtonTemplate}" />
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  左侧菜单与页面区域共用窗口 VM；只保留一个 MainRegion 宿主。  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <components:LeftNavMode x:Name="LeftNavigation" Panel.ZIndex="1" />
                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  微量主色铺底让留白更柔和，卡片与菜单保持独立的视觉层次。  -->
                            <Border
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                IsHitTestVisible="False"
                                Opacity="0.025" />
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OpenTabs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding OpenTabs}" x:Name="WorkspaceTabs">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,0" CornerRadius="4" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Height="32" Padding="10,0,8,0" MinWidth="80" MaxWidth="200"
                                                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                                                    AutomationProperties.Name="{Binding Title}">
                                                                <DockPanel>
                                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                            </Button>
                                                            <Button Grid.Column="1" Width="22" Height="22" Margin="0,0,2,0" VerticalAlignment="Center"
                                                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                                    Click="PopOutPageClick"
                                                                    ToolTip="弹出页面"
                                                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="Padding" Value="0" />
                                                                        <Setter Property="MinWidth" Value="0" />
                                                                        <Setter Property="MinHeight" Value="0" />
                                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Grid Background="Transparent">
                                                                                        <Border x:Name="HoverSurface" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0" />
                                                                                        <ContentPresenter x:Name="CloseGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                                                                                    </Grid>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.12" />
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="1" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.18" />
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="1" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsPressed" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.24" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="0.3" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                                <materialDesign:PackIcon Kind="OpenInNew" Width="12" Height="12" />
                                                            </Button>
                                                            <Button Grid.Column="2" Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}"
                                                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="Padding" Value="0" />
                                                                        <Setter Property="MinWidth" Value="0" />
                                                                        <Setter Property="MinHeight" Value="0" />
                                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Grid Background="Transparent">
                                                                                        <Border x:Name="HoverSurface" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0" />
                                                                                        <ContentPresenter x:Name="CloseGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                                                                                    </Grid>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.12" />
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="1" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.18" />
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="1" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsPressed" Value="True">
                                                                                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.24" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                            <Setter TargetName="CloseGlyph" Property="Opacity" Value="0.3" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                                <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            <Grid Margin="16">
                                <!-- Keep the shadow on an empty surface: page controls must not
                                     become part of the bitmap processed by DropShadowEffect. -->
                                <Border Style="{StaticResource WorkspaceCard}" IsHitTestVisible="False" />
                                <Border Padding="20">
                                    <ContentControl region:RegionManager.RegionName="MainRegion" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                </Border>
                            </Grid>
                            </DockPanel>
                            <Border Grid.Row="1" MinHeight="25" Padding="20,6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                                <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:ViewModelLocator.EntranceLang}, Path=Management_SwitchAccount}" Click="SwitchAccountClick" Style="{StaticResource MaterialDesignFlatButton}" Height="24" FontSize="11" Padding="8,0"/>
                                <TextBlock x:Name="FooterTextBlock"
                                           Text="{Binding FooterText}"
                                           FontSize="8" Opacity="0.65"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FooterText}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </AdornerDecorator>
</Window>
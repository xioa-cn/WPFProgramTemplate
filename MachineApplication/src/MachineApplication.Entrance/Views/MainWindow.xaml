<Window
    x:Class="MachineApplication.Entrance.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:MachineApplication.Entrance.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApplication.Entrance.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:region="clr-namespace:Machine.ModuleLoad.Region;assembly=Machine.ModuleLoad"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:MachineApplication.Entrance.ViewModels"
    Title="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=Global_AppName}"
    Width="1040"
    Height="640"
    MinWidth="640"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    BorderThickness="0"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    FontSize="14"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <!--  系统非客户区负责拖动、双击最大化和边缘缩放，无需鼠标事件。  -->
        <shell:WindowChrome
            CaptionHeight="70"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="BorderThickness" Value="0" />
            <!--  替换系统虚线焦点框；仅键盘导航时显示淡色背景提示。  -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border
                                        Background="#20147D92"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CaptionButton"
            BasedOn="{StaticResource WindowButton}"
            TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
            <!--  70 像素标题栏中使用 44 像素按钮，垂直居中后上下各留 13 像素。  -->
            <Setter Property="Height" Value="44" />
        </Style>
        <Style
            x:Key="NavigationButton"
            BasedOn="{StaticResource WindowButton}"
            TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <AdornerDecorator>
        <Border
            Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
            BorderThickness="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!--  最大化时为系统缩放边框留出内容边距。  -->
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Padding" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  标题栏跟随主题主色，波纹揭开旧截图时可见整条标题栏逐步换色。  -->
                <Border
                    x:Name="ThemeTitleBar"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                    <Grid Margin="16,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  轻微顶部反光保留主色，避免整条标题栏呈现生硬的纯色块。  -->
                        <Border
                            Grid.ColumnSpan="2"
                            Margin="-16,0,-6,0"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#22FFFFFF" />
                                    <GradientStop Offset="0.65" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#08000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,12,0"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Kind="ViewDashboardOutline" />
                            <TextBlock
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                x:Name="ThemeButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_ThemeColor}"
                                Command="{Binding ShowThemeColorsCommand}"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_ThemeColor}">
                                <materialDesign:PackIcon
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                    Kind="PaletteOutline" />
                            </Button>
                            <Button
                                x:Name="PinButton"
                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Command="{x:Static local:WindowCommands.ToggleTopmost}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="ToolTip" Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Pin}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                                <Setter Property="ToolTip" Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Unpin}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="Pin" />
                            </Button>
                            <Border
                                Width="1"
                                Height="16"
                                Margin="8,0"
                                Background="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Opacity="0.25" />
                            <Button
                                x:Name="MinimizeButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Minimize}"
                                Command="{x:Static local:WindowCommands.Minimize}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Minimize}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="WindowMinimize" />
                            </Button>
                            <Button
                                x:Name="MaximizeButton"
                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Command="{x:Static local:WindowCommands.ToggleMaximize}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="ToolTip" Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Maximize}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="ToolTip" Value="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Restore}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="17" Height="17">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="WindowMaximize" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Kind" Value="WindowRestore" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button
                                x:Name="CloseButton"
                                AutomationProperties.Name="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}"
                                Command="{x:Static local:WindowCommands.Close}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{Binding Source={x:Static vm:ViewModelLocator.EntranceLang}, Path=MainWindow_Close}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CaptionButton}" TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="CloseSurface"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CloseSurface" Property="Background" Value="#D93649" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="CloseSurface" Property="Background" Value="#B62235" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  左侧菜单与页面区域共用窗口 VM；只保留一个 MainRegion 宿主。  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <components:LeftNavMode x:Name="LeftNavigation" Panel.ZIndex="1" />
                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid>
                            <!--  微量主色铺底让留白更柔和，卡片与菜单保持独立的视觉层次。  -->
                            <Border
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                IsHitTestVisible="False"
                                Opacity="0.025" />
                            <Border
                                Margin="16,16,16,16"
                                Padding="20"
                                Style="{StaticResource WorkspaceCard}">
                                <ContentControl region:RegionManager.RegionName="MainRegion" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </AdornerDecorator>
</Window>



<Page
    x:Class="AIAgentFrameworkModule.Views.AgentChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AIAgentFrameworkModule.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:utils="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
    Title="AI 对话调试"
    d:DesignHeight="880"
    d:DesignWidth="1100"
    utils:ViewDesignInclude.Source="/AIAgentFrameworkModule;component/Design/SharedStyles.xaml"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AgentTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  用户只显示原文，避免把用户的特殊字符误识别为 Markdown。助手使用原生富文本。  -->
            <DataTemplate x:Key="UserMessage">
                <Border
                    MaxWidth="620"
                    Margin="80,10,0,14"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AI.UserBubble}">
                    <TextBox
                        Padding="0"
                        AutomationProperties.Name="用户消息（可选择复制）"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                        FontSize="16"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                        IsReadOnly="True"
                        SelectionBrush="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                        SelectionOpacity="0.35"
                        Style="{StaticResource AI.BubbleText}"
                        Text="{Binding Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="AssistantMessage">
                <Border
                    MaxWidth="780"
                    Margin="0,10,80,14"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AI.AssistantBubble}">
                    <StackPanel>
                        <StackPanel
                            Margin="0,0,0,10"
                            Orientation="Horizontal"
                            Visibility="{Binding IsWaiting, Converter={StaticResource AI.Visible}}">
                            <TextBlock
                                FontSize="15"
                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                Text="正在思考"
                                ToolTip="正在等待模型响应，不代表展示了模型内部推理内容" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="15"
                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                Text=" · · ·" />
                        </StackPanel>
                        <!--  气泡按内容收缩，遇到表格或代码块时自动使用完整宽度。  -->
                        <controls:BubbleWidthSizer>
                            <controls:MarkdownMessageView
                                AutomationProperties.Name="助手回答，支持 Markdown 与代码"
                                IsGenerating="{Binding IsGenerating, Mode=OneWay}"
                                MarkdownText="{Binding Text, Mode=OneWay}" />
                        </controls:BubbleWidthSizer>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button
                                Padding="7"
                                AutomationProperties.Name="复制回答"
                                Click="OnCopyMessage"
                                Style="{StaticResource AI.Button}"
                                ToolTip="复制原始 Markdown">
                                <md:PackIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Kind="ContentCopy" />
                            </Button>
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                Text="{Binding Time}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="SystemMessage">
                <Border
                    Margin="0,6,0,18"
                    Padding="12,9"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,0,0,1">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Page.InputBindings>
        <KeyBinding
            Key="Enter"
            Command="{Binding SendCommand}"
            Modifiers="Control" />
    </Page.InputBindings>
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  保持顶部轻量，不让调试参数挤占阅读区域。  -->
        <DockPanel Margin="18,10,20,8" LastChildFill="True">
            <Button
                Margin="0,0,8,0"
                Padding="10"
                AutomationProperties.Name="新对话"
                Command="{Binding NewConversationCommand}"
                DockPanel.Dock="Left"
                Style="{StaticResource AI.Button}"
                ToolTip="新对话，清空当前上下文">
                <md:PackIcon
                    Width="21"
                    Height="21"
                    Kind="SquareEditOutline" />
            </Button>
            <Button
                Click="OnOpenConfiguration"
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsIdle}"
                Style="{StaticResource AI.Button}"
                ToolTip="打开模型配置">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon
                        Width="17"
                        Height="17"
                        Margin="0,0,8,0"
                        Kind="Tune" />
                    <TextBlock Text="模型配置" />
                </StackPanel>
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding ConversationTitle}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="24,0">
            <StackPanel
                Margin="20,0,20,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="今天想一起探索什么？"
                    TextWrapping="Wrap" />
                <!--<TextBlock
                    Margin="0,13,0,24"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="解释概念、阅读代码，或验证你的模型连接。"
                    TextWrapping="Wrap" />-->
                <!--<WrapPanel HorizontalAlignment="Center">
                    <Button
                        Margin="4"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        Click="OnSuggestion"
                        Content="解释 C# 异步"
                        Style="{StaticResource AI.Button}"
                        Tag="请用简单示例解释 C# 的 async 和 await。" />
                    <Button
                        Margin="4"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        Click="OnSuggestion"
                        Content="代码 + 表格 + 表情"
                        Style="{StaticResource AI.Button}"
                        Tag="请用中文介绍 C# List：包含标题、列表、对比表格、一个 csharp 代码块，以及 Emoji 表情。" />
                </WrapPanel>-->
            </StackPanel>
            <ItemsControl
                x:Name="MessageList"
                ItemsSource="{Binding Messages}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.CacheLength="1"
                VirtualizingPanel.CacheLengthUnit="Page"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly"
                            ScrollChanged="OnMessagesScrollChanged"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0,14,0,24" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="MaxWidth" Value="920" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl HorizontalContentAlignment="Stretch" Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AssistantMessage}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="你">
                                            <Setter Property="ContentTemplate" Value="{StaticResource UserMessage}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="系统">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SystemMessage}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  输入框与阅读列共用 920px 上限，小窗口时自动收缩。  -->
        <Grid
            Grid.Row="2"
            MaxWidth="920"
            Margin="24,4,24,12"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Padding="20,15,14,12"
                Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1"
                CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid MinHeight="54" Margin="0,0,0,10">
                        <TextBox
                            x:Name="PromptBox"
                            MinHeight="52"
                            MaxHeight="180"
                            Padding="0,2"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            AutomationProperties.Name="输入问题，Enter 发送，Shift 加 Enter 换行"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            IsEnabled="{Binding IsIdle}"
                            PreviewKeyDown="OnPromptPreviewKeyDown"
                            Style="{StaticResource AI.Field}"
                            Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="16"
                            Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                            IsHitTestVisible="False"
                            Text="发送消息，支持代码与表情…"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Prompt}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton
                                x:Name="EmojiToggle"
                                Width="34"
                                Height="34"
                                AutomationProperties.Name="打开表情选择器"
                                Content="☺"
                                FontFamily="Segoe UI Symbol"
                                FontSize="22"
                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                IsEnabled="{Binding IsIdle}"
                                ToolTip="插入表情">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="EmojiFrame"
                                            Background="Transparent"
                                            CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EmojiFrame" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListView.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="EmojiFrame" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                <Setter TargetName="EmojiFrame" Property="BorderThickness" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsChecked, ElementName=EmojiToggle}"
                                Placement="Top"
                                PlacementTarget="{Binding ElementName=EmojiToggle}"
                                StaysOpen="False">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <ItemsControl x:Name="EmojiChoicesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Width="240" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="3"
                                                    Click="OnEmojiSelected"
                                                    Content="{Binding}"
                                                    FontFamily="Segoe UI Emoji"
                                                    FontSize="22"
                                                    Style="{StaticResource AI.Button}"
                                                    ToolTip="插入此表情" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                            <CheckBox
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                Content="流式"
                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                IsChecked="{Binding UseStreaming}"
                                IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="140"
                            MaxWidth="240"
                            Margin="10,0"
                            HorizontalAlignment="Right"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="当前模型"
                            IsEnabled="{Binding IsIdle}"
                            ItemTemplate="{StaticResource AI.ProfileItem}"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                            Style="{StaticResource AI.Combo}"
                            ToolTip="切换模型将清空当前对话" />
                        <Grid
                            Grid.Column="2"
                            Width="38"
                            Height="38">
                            <Button
                                AutomationProperties.Name="发送消息"
                                Command="{Binding SendCommand}"
                                ToolTip="发送 · Enter（Shift+Enter 换行，兼容 Ctrl+Enter）">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AI.PrimaryButton}" TargetType="Button">
                                        <Setter Property="Padding" Value="9" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <md:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="ArrowUp" />
                            </Button>
                            <Button
                                Padding="10"
                                AutomationProperties.Name="停止生成"
                                Command="{Binding StopCommand}"
                                Style="{StaticResource AI.PrimaryButton}"
                                ToolTip="停止生成"
                                Visibility="{Binding IsBusy, Converter={StaticResource AI.Visible}}">
                                <md:PackIcon
                                    Width="18"
                                    Height="18"
                                    Kind="Stop" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock
                Grid.Row="1"
                Margin="12,9,12,0"
                AutomationProperties.LiveSetting="Polite"
                FontSize="11"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                Text="{Binding Status}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Status}" />
        </Grid>
    </Grid>
</Page>

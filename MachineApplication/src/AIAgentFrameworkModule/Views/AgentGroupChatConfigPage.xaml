<Page x:Class="AIAgentFrameworkModule.Views.AgentGroupChatConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utils="clr-namespace:Machine.ModuleLoad.Utils;assembly=Machine.ModuleLoad"
      utils:ViewDesignInclude.Source="/AIAgentFrameworkModule;component/Design/SharedStyles.xaml"
      Title="群聊配置" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Background="{DynamicResource MaterialDesign.Brush.Background}"
      Loaded="OnLoaded">
    <Page.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AgentWorkflowTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Page.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="返回聊天室" Click="OnChat" Style="{StaticResource Workflow.Button}" VerticalAlignment="Center" />
            <StackPanel><TextBlock Text="GROUP SETTINGS" Style="{StaticResource Workflow.Caption}" FontSize="10" /><TextBlock Text="打造你的 AI 群友" FontSize="22" FontWeight="SemiBold" Margin="0,4" /><TextBlock Text="昵称、人设与模型各自独立；可重复使用同一模型。" Style="{StaticResource Workflow.Caption}" /></StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}">
                <Border Style="{StaticResource Workflow.Surface}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="聊天室" Style="{StaticResource Workflow.Label}" />
                        <TextBlock Text="群名称" Style="{StaticResource Workflow.Caption}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AI.Field}" MaxLength="60" AutomationProperties.Name="群名称" />
                        <TextBlock Text="群约定 / 共同话题" Style="{StaticResource Workflow.Caption}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AI.Field}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="群约定" />
                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="每次消息回复轮数" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding RoundOptions}" SelectedItem="{Binding Rounds}" Width="90" Style="{StaticResource AI.Combo}" AutomationProperties.Name="回复轮数" />
                        </WrapPanel>
                        <TextBlock Text="一轮内所有启用成员依次接话。此轮数仅用于普通发送；聊天室开启连续聊天后不限制轮数，直到关闭开关或离开页面，期间会持续调用模型并可能产生费用。" Style="{StaticResource Workflow.Caption}" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Right" Content="添加群友" Command="{Binding AddMemberCommand}" Style="{StaticResource Workflow.Button}" />
                    <StackPanel><TextBlock Text="AI 群友" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="1–8 位成员 · 按列表顺序发言 · 不启用的成员不会调用模型" Style="{StaticResource Workflow.Caption}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Workflow.Surface}" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="移除" Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource Workflow.Button}" MinHeight="30" Padding="10,4" />
                                    <CheckBox Content="参与聊天" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="昵称" Style="{StaticResource Workflow.Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AI.Field}" MaxLength="24" AutomationProperties.Name="群友昵称" />
                                <TextBlock Text="使用的模型配置" Style="{StaticResource Workflow.Caption}" Margin="0,12,0,5" />
                                <ComboBox ItemsSource="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding Profile}" DisplayMemberPath="Name" Style="{StaticResource AI.Combo}" AutomationProperties.Name="群友模型" />
                                <TextBlock Text="人设 / 聊天风格" Style="{StaticResource Workflow.Caption}" Margin="0,12,0,5" />
                                <TextBox Text="{Binding Persona, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AI.Field}" AcceptsReturn="True" TextWrapping="Wrap" Height="84" VerticalScrollBarVisibility="Auto" MaxLength="4000" AutomationProperties.Name="群友人设" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource Workflow.Surface}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Workflow.Caption}" FontSize="11" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="保存群聊配置" Command="{Binding SaveCommand}" Style="{StaticResource Workflow.PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="管理模型与密钥" Click="OnModels" Style="{StaticResource Workflow.Button}" />
                </WrapPanel>
                <TextBlock Text="编辑即作用于本次群聊；保存后下次启动恢复。群配置不含密钥与聊天记录；更改成员后需重新确认跨模型数据传递。" Style="{StaticResource Workflow.Caption}" FontSize="10" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

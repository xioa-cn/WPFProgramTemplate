<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- 仅在工作流页面内覆盖主题资源，不改变宿主的主题或其他模块。 -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="#171E2D" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Card.Background" Color="#202839" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="#E4EAF5" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#A38AFF" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Separator.Background" Color="#354057" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ValidationError" Color="#FF879C" />
    <SolidColorBrush x:Key="Workflow.Muted" Color="#98A8C3" />
    <SolidColorBrush x:Key="Workflow.Surface" Color="#252F43" />
    <SolidColorBrush x:Key="Workflow.Accent" Color="#AC8CFF" />
    <SolidColorBrush x:Key="Workflow.Green" Color="#63D7AB" />
    <SolidColorBrush x:Key="Workflow.Node.Surface" Color="#2B3448" />
    <SolidColorBrush x:Key="Workflow.Node.SurfaceBottom" Color="#212A3C" />
    <SolidColorBrush x:Key="Workflow.Node.Border" Color="#576780" />
    <LinearGradientBrush x:Key="Workflow.Header" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A344A" Offset="0" />
        <GradientStop Color="#202839" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Workflow.Toolbar" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#283348" Offset="0" />
        <GradientStop Color="#1D2536" Offset="1" />
    </LinearGradientBrush>
    <!-- 双段滑动开关：未选中为左右，选中为上下；保留键盘焦点和空格切换能力。 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Workflow.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workflow.Node.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Workflow.PortOrientationSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="116" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="7" BorderThickness="1" BorderBrush="#495873" Background="#151F30">
                        <Grid Margin="3">
                            <Border Width="53" HorizontalAlignment="Left" CornerRadius="4" Background="#65518B" IsHitTestVisible="False">
                                <Border.RenderTransform><TranslateTransform x:Name="Slider" /></Border.RenderTransform>
                            </Border>
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="HorizontalLabel" Text="左右" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="VerticalLabel" Grid.Column="1" Text="上下" FontSize="11" Foreground="#98A8C3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HorizontalLabel" Property="Foreground" Value="#98A8C3" />
                            <Setter TargetName="VerticalLabel" Property="Foreground" Value="White" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="X" To="54" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#DDD1FF" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#AC8CFF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Workflow.ToolButton" TargetType="Button">
        <Setter Property="Foreground" Value="#CFD9EB" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#6F84AE" /><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#384667" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#C5B3FF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Workflow.SaveButton" TargetType="Button" BasedOn="{StaticResource Workflow.ToolButton}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B77858" />
        <Setter Property="Background">
            <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#9E5D40" Offset="0" /><GradientStop Color="#704333" Offset="1" /></LinearGradientBrush></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Workflow.AddButton" TargetType="Button" BasedOn="{StaticResource Workflow.ToolButton}">
        <Setter Property="Foreground" Value="#DCF8EB" />
        <Setter Property="BorderBrush" Value="#3C826E" />
        <Setter Property="Background" Value="#244F45" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Foreground" Value="#E4EAF5" />
        <Setter Property="CaretBrush" Value="#E4EAF5" />
        <Setter Property="Background" Value="#192232" />
        <Setter Property="BorderBrush" Value="#495873" />
        <Setter Property="SelectionBrush" Value="#7457A8" />
        <Setter Property="md:HintAssist.Foreground" Value="#98A8C3" />
    </Style>
    <!-- 独立勾选框模板避免宿主浅色主题的未选中描边在深色工作台中不可见。 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#D9E4F5" />
        <Setter Property="BorderBrush" Value="#8B9BBA" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="CheckFrame" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                VerticalAlignment="Center" Background="#192232" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckFrame" Property="Background" Value="#7151B4" />
                            <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#BAA2FF" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckMark" Property="Text" Value="−" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#D3C4FF" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#FFFFFF" /><Setter TargetName="CheckFrame" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Foreground" Value="#E4EAF5" />
        <Setter Property="Background" Value="#202839" />
        <Setter Property="BorderBrush" Value="#495873" />
    </Style>
</ResourceDictionary>

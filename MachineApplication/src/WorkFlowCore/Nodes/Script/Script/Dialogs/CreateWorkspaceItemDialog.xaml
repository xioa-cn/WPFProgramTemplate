<Window x:Class="CsxPad.Wpf.Dialogs.CreateWorkspaceItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding DialogTitle, Mode=OneWay, RelativeSource={RelativeSource Self}}" Width="440" Height="230"
        MinWidth="400" MinHeight="220" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource IdeSurfaceBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IdeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Border BorderBrush="{StaticResource IdeBorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0" Style="{StaticResource IdeGlyphStyle}"
                                        Foreground="{StaticResource IdeAccentBrush}"
                                        Kind="{Binding DialogIcon, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IdeTextBrush}"
                                   Text="{Binding DialogTitle, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IdeTopBarIconButtonStyle}" ToolTip="Cancel" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <md:PackIcon Width="11" Height="11" Style="{StaticResource IdeGlyphStyle}"
                                        Kind="Close" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18,14,18,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock FontSize="11" Foreground="{StaticResource IdeTextMutedBrush}" Text="LOCATION" />
                <TextBlock Grid.Row="1" Margin="0,4,0,12" FontSize="12" Foreground="{StaticResource IdeTextBrush}"
                           Text="{Binding TargetDirectory, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TargetDirectory, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource IdeTextBrush}"
                               Text="{Binding InputLabel, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBox x:Name="ItemPathBox" Grid.Column="1" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                             TextChanged="ItemPathBox_TextChanged" KeyDown="ItemPathBox_KeyDown" />
                </Grid>
                <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="48,5,0,0" FontSize="11"
                           Foreground="{StaticResource IdeDangerBrush}" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="0,0,14,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="78" Height="30" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="CreateButton" Width="86" Height="30" FontWeight="SemiBold"
                            Background="{StaticResource IdeAccentBrush}" Foreground="#082432"
                            BorderBrush="{StaticResource IdeAccentBrush}"
                            Content="{Binding ConfirmText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" Click="Create_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

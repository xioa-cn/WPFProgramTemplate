<Window x:Class="CsxPad.Wpf.Dialogs.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Delete" Width="440" Height="210" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource IdeSurfaceBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IdeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Border BorderBrush="{StaticResource IdeBorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
            <Border Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0" Style="{StaticResource IdeGlyphStyle}"
                                        Foreground="{StaticResource IdeDangerBrush}" Kind="DeleteOutline" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IdeTextBrush}" Text="Delete workspace item" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IdeTopBarIconButtonStyle}" ToolTip="Cancel" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <md:PackIcon Width="11" Height="11" Style="{StaticResource IdeGlyphStyle}"
                                        Kind="Close" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18,18,18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <md:PackIcon Width="20" Height="20" VerticalAlignment="Top" Style="{StaticResource IdeGlyphStyle}"
                                Foreground="{StaticResource IdeDangerBrush}" Kind="DeleteOutline" />
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{StaticResource IdeTextBrush}" TextWrapping="Wrap">
                        <Run Text="Delete "/><Run FontWeight="SemiBold" Text="{Binding ItemName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"/><Run Text="?"/>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource IdeTextMutedBrush}"
                               Text="{Binding WarningText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="0,0,14,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="78" Height="30" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click" />
                    <Button Width="86" Height="30" FontWeight="SemiBold" Background="{StaticResource IdeDangerBrush}"
                            Foreground="#2A080A" BorderBrush="{StaticResource IdeDangerBrush}" Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

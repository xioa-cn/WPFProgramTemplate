<UserControl
    x:Class="CsxPad.Wpf.Controls.IdeTopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Height="44">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WorkFlowCore;component/Nodes/Script/Script/Resources/IdeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Background="{StaticResource IdeSurfaceRaisedBrush}"
        BorderBrush="{StaticResource IdeBorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Border
                    Width="26"
                    Height="26"
                    Background="{StaticResource IdeAccentBrush}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IdeCodeFont}"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#082432"
                        Text="C#" />
                </Border>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource IdeTextBrush}"
                    Text="CSXPad" />
                <md:PackIcon
                    Width="18"
                    Height="14"
                    Margin="6,1,0,0"
                    Kind="MicrosoftDotNet"
                    Foreground="{StaticResource IdeAccentBrush}"
                    Style="{StaticResource IdeFilledGlyphStyle}" />
                <Border
                    Width="1"
                    Height="20"
                    Margin="11,0,7,0"
                    Background="{StaticResource IdeBorderBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Orientation="Horizontal">
                <Button
                    Command="{Binding NewScriptCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="New script (Ctrl+N)">
                    <md:PackIcon Kind="Plus" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding OpenScriptCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Open local CSX (Ctrl+O)">
                    <md:PackIcon Kind="FolderOutline" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding SaveScriptCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Save script (Ctrl+S)">
                    <md:PackIcon Kind="ContentSaveOutline" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Border
                    Width="1"
                    Height="20"
                    Margin="7,0,9,0"
                    Background="{StaticResource IdeBorderBrush}" />
                <StackPanel
                    MaxWidth="280"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="{Binding DocumentPath}">
                    <md:PackIcon
                        Margin="0,0,7,0"
                        Kind="FileCodeOutline"
                        Foreground="{StaticResource IdeTextMutedBrush}"
                        Style="{StaticResource IdeGlyphStyle}" />
                    <TextBlock
                        MaxWidth="235"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IdeTextBrush}"
                        Text="{Binding DocumentTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="8"
                        Foreground="{StaticResource IdeWarningBrush}"
                        Text="●"
                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="3"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Orientation="Horizontal">
                <Border
                    Height="32"
                    MinWidth="136"
                    Margin="0,0,6,0"
                    Padding="10,0"
                    Background="{StaticResource IdeSurfaceBrush}"
                    BorderBrush="{StaticResource IdeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <md:PackIcon
                            Margin="0,0,7,0"
                            Kind="FileCodeOutline"
                            Foreground="{StaticResource IdeAccentBrush}"
                            Style="{StaticResource IdeGlyphStyle}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource IdeTextBrush}"
                            Text="C# Script" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="12"
                            Foreground="{StaticResource IdeTextMutedBrush}"
                            Text=".NET 8" />
                    </StackPanel>
                </Border>
                <Button
                    Command="{Binding RunCommand}"
                    Style="{StaticResource IdeTopBarRunButtonStyle}"
                    ToolTip="Run script (F5)">
                    <md:PackIcon Kind="Play" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding DebugCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Debug script (F6)">
                    <md:PackIcon Kind="BugOutline" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding ContinueDebugCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Continue debugging (F8)">
                    <md:PackIcon Kind="PlayPause" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding StepDebugCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Step over (F10)">
                    <md:PackIcon Kind="DebugStepOver" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Command="{Binding StopCommand}"
                    Style="{StaticResource IdeTopBarIconButtonStyle}"
                    ToolTip="Stop execution">
                    <md:PackIcon Kind="Stop" Style="{StaticResource IdeGlyphStyle}" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="4"
                HorizontalAlignment="Right"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Orientation="Horizontal">
                <Button
                    Click="Minimize_Click"
                    Style="{StaticResource IdeCaptionButtonStyle}"
                    ToolTip="Minimize">
                    <md:PackIcon
                        Width="11"
                        Height="11"
                        Kind="WindowMinimize"
                        Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    x:Name="MaximizeRestoreButton"
                    Click="MaximizeRestore_Click"
                    Style="{StaticResource IdeCaptionButtonStyle}"
                    ToolTip="Maximize">
                    <md:PackIcon
                        x:Name="MaximizeRestoreIcon"
                        Width="11"
                        Height="11"
                        Kind="WindowMaximize"
                        Style="{StaticResource IdeGlyphStyle}" />
                </Button>
                <Button
                    Click="Close_Click"
                    Style="{StaticResource IdeCloseCaptionButtonStyle}"
                    ToolTip="Close">
                    <md:PackIcon
                        Width="11"
                        Height="11"
                        Kind="Close"
                        Style="{StaticResource IdeGlyphStyle}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="CsxPad.Wpf.Controls.WorkspaceExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:CsxPad.Wpf.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WorkFlowCore;component/Nodes/Script/Script/Resources/IdeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <HierarchicalDataTemplate DataType="{x:Type models:ScriptWorkspaceItem}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon x:Name="ItemIcon" Margin="0,0,5,0" Style="{StaticResource IdeGlyphStyle}"
                                    Foreground="{StaticResource IdeAccentBrush}"
                                    Kind="FileCodeOutline" />
                    <TextBlock x:Name="ItemName" VerticalAlignment="Center" FontSize="12"
                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter TargetName="ItemIcon" Property="Kind" Value="FolderOutline" />
                        <Setter TargetName="ItemIcon" Property="Foreground" Value="{StaticResource IdeWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsWorkspaceRoot}" Value="True">
                        <Setter TargetName="ItemIcon" Property="Width" Value="21" />
                        <Setter TargetName="ItemIcon" Property="Height" Value="21" />
                        <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="ItemName" Property="Foreground" Value="{StaticResource IdeTextBrush}" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource IdeSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <TextBlock Margin="12,0" VerticalAlignment="Center" Style="{StaticResource IdePaneHeaderStyle}" Text="EXPLORER" />
        <Grid Grid.Row="1" Margin="8,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button HorizontalContentAlignment="Left" Padding="7,0" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource IdeTextMutedBrush}" Command="{Binding OpenWorkspaceCommand}" ToolTip="Open a script folder">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Margin="0,0,7,0" Style="{StaticResource IdeGlyphStyle}"
                                    Kind="FolderOutline" />
                    <TextBlock FontSize="11" Text="Open Folder" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource IdeTopBarIconButtonStyle}"
                    Command="{Binding CreateWorkspaceScriptCommand}" ToolTip="New CSX file">
                <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                Kind="FileCodeOutline" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource IdeTopBarIconButtonStyle}"
                    Command="{Binding CreateWorkspaceFolderCommand}" ToolTip="New folder">
                <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                Kind="FolderOutline" />
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <TreeView x:Name="WorkspaceTree" Margin="5,2,5,4" Padding="2" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding WorkspaceItems}"
                      PreviewKeyDown="WorkspaceTree_PreviewKeyDown"
                      PreviewMouseRightButtonDown="WorkspaceTree_PreviewMouseRightButtonDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource IdeTreeItemStyle}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Rename" InputGestureText="F2"
                                              Command="{Binding PlacementTarget.Tag.RenameWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                            Kind="PencilOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete"
                                              InputGestureText="Delete"
                                              Command="{Binding PlacementTarget.Tag.DeleteWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                            Foreground="{StaticResource IdeDangerBrush}"
                                                            Kind="DeleteOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="New CSX File"
                                                      Command="{Binding PlacementTarget.Tag.CreateScriptInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                                    Kind="Plus" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="New Folder"
                                                      Command="{Binding PlacementTarget.Tag.CreateFolderInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                                    Kind="FolderOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Rename" InputGestureText="F2"
                                                      Command="{Binding PlacementTarget.Tag.RenameWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                                    Kind="PencilOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Delete"
                                                      InputGestureText="Delete"
                                                      Command="{Binding PlacementTarget.Tag.DeleteWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                                                    Foreground="{StaticResource IdeDangerBrush}"
                                                                    Kind="DeleteOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding WorkspacePath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <md:PackIcon Width="30" Height="30" HorizontalAlignment="Center" Style="{StaticResource IdeGlyphStyle}"
                                Foreground="{StaticResource IdeBorderStrongBrush}"
                                Kind="FolderOutline" />
                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource IdeTextMutedBrush}"
                           Text="Open a folder to browse scripts" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Padding="8,4" Background="{StaticResource IdeSurfaceRaisedBrush}"
                BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Height="30" HorizontalContentAlignment="Left" Padding="8,0"
                        Command="{Binding CreateWorkspaceScriptCommand}" ToolTip="Create a CSX file in this folder">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Margin="0,0,7,0" Style="{StaticResource IdeGlyphStyle}"
                                        Kind="Plus" />
                        <TextBlock FontSize="11" Text="New CSX File" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Width="34" Height="30" Margin="6,0,0,0"
                        Command="{Binding CreateWorkspaceFolderCommand}" ToolTip="New folder">
                    <md:PackIcon Style="{StaticResource IdeGlyphStyle}"
                                    Kind="FolderOutline" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

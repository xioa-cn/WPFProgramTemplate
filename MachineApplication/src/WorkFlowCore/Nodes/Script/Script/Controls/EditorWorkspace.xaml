<UserControl x:Class="CsxPad.Wpf.Controls.EditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helpers="clr-namespace:CsxPad.Wpf.Helpers"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WorkFlowCore;component/Nodes/Script/Script/Resources/IdeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="14,0" Orientation="Horizontal" VerticalAlignment="Center">
                <md:PackIcon Style="{StaticResource IdeGlyphStyle}" Foreground="{StaticResource IdeAccentBrush}"
                                Kind="FileCodeOutline" />
                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource IdeTextBrush}" Text="{Binding DocumentTitle}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource IdeWindowBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <avalonEdit:TextEditor x:Name="CodeEditor" FontFamily="{StaticResource IdeCodeFont}" FontSize="14"
                                       Foreground="#D8DEE9" Background="{StaticResource IdeWindowBrush}"
                                       LineNumbersForeground="{StaticResource IdeTextMutedBrush}" ShowLineNumbers="True"
                                       IsReadOnly="{Binding IsRunning}"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                       helpers:CSharpEditorAssist.IsEnabled="True"
                                       helpers:CSharpEditorAssist.CompletionCatalog="{Binding PackageCompletionCatalog}"
                                       helpers:CSharpEditorAssist.ScriptPath="{Binding CurrentScriptPath}"
                                       helpers:CSharpEditorAssist.DebugPause="{Binding CurrentDebugPause}"
                                       helpers:AvalonEditorBinding.Text="{Binding ScriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <avalonEdit:TextEditor.Options><avalonEdit:TextEditorOptions ConvertTabsToSpaces="True" IndentationSize="4" EnableHyperlinks="False" HighlightCurrentLine="True" ShowColumnRuler="True" ColumnRulerPosition="120" /></avalonEdit:TextEditor.Options>
                </avalonEdit:TextEditor>
                <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
        <Grid x:Name="BottomPaneHost" Grid.Row="2" Height="285" MinHeight="170"
              Visibility="{Binding IsBottomPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="5" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <GridSplitter Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource IdeWindowBrush}" DragDelta="BottomPaneSplitter_DragDelta" />
            <Border Grid.Row="1" Background="{StaticResource IdeSurfaceBrush}"
                    BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid Visibility="{Binding IsResultsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                Margin="12"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding ResultSections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,14,14" HorizontalAlignment="Left">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Padding="9,5"
                                                Background="#24547A"
                                                BorderBrush="{StaticResource IdeBorderStrongBrush}"
                                                BorderThickness="1,1,1,0"
                                                Visibility="{Binding ShowTitle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding Title}" />
                                            </Border>
                                            <DataGrid
                                                Grid.Row="1"
                                                MinWidth="0"
                                                Margin="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                AlternationCount="2"
                                                AutoGenerateColumns="True"
                                                AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                                                ColumnWidth="SizeToCells"
                                                HeadersVisibility="{Binding ShowHeaders, Converter={StaticResource ResultHeadersVisibilityConverter}}"
                                                ItemsSource="{Binding View}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                Style="{StaticResource IdeResultInspectorGridStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="1" Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{StaticResource IdeTextMutedBrush}" Text="{Binding RowCount}" />
                                <TextBlock Margin="8,0" Foreground="{StaticResource IdeBorderStrongBrush}" Text="•" />
                                <TextBlock FontSize="11" Foreground="{StaticResource IdeTextMutedBrush}" Text="{Binding ExecutionTime}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBox Padding="14" FontFamily="{StaticResource IdeCodeFont}" Foreground="{StaticResource IdeTextBrush}"
                             Background="{StaticResource IdeSurfaceBrush}" BorderThickness="0" IsReadOnly="True"
                             AcceptsReturn="True" Text="{Binding OutputText}"
                             Visibility="{Binding IsOutputOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="BottomToolBar" Grid.Row="3" Background="{StaticResource IdeSurfaceRaisedBrush}" BorderBrush="{StaticResource IdeBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource IdeToolWindowButtonStyle}" IsChecked="{Binding IsResultsOpen, Mode=OneWay}"
                              Command="{Binding ToggleResultsCommand}" ToolTip="Show or hide results">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="14" Height="14" Margin="0,0,6,0" Style="{StaticResource IdeGlyphStyle}"
                                        Kind="Table" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="Results" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource IdeToolWindowButtonStyle}" IsChecked="{Binding IsOutputOpen, Mode=OneWay}"
                              Command="{Binding ToggleOutputCommand}" ToolTip="Show or hide output">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="14" Height="14" Margin="0,0,6,0" Style="{StaticResource IdeGlyphStyle}"
                                        Kind="Console" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="Output" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

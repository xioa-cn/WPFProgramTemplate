    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CSharpScriptCore\CSharpScriptCore.csproj" />
    <ProjectReference Include="..\Machine.ModuleLoad\Machine.ModuleLoad.csproj" />
    <ProjectReference Include="..\I18n.LangsGenerator\I18n.LangsGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**/lang.*.json" Exclude="bin/**;obj/**" />

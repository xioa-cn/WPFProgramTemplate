  <ItemGroup>
    <Page Include="..\MachineApplication.Entrance\AppResources.xaml">
      <Link>Design/SharedStyles.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Nodes\Script\Script\Resources\CsxDark.xshd" />

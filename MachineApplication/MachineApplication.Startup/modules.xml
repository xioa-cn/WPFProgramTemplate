<?xml version="1.0" encoding="utf-8"?>
<wpfModules>
    <!-- 单元模块 -->
    <unitModules Name="Common" LoadMode="SourceGenerator">
        <!-- 单元模块中的dll模块 -->
        <dllModule Name="MachineApplication" Dll="MachineApplication.Entrance" Path=".">
            <!-- dll模块中的加载类 -->
            <loadClass Name="EntranceModule"/>
        </dllModule>
    </unitModules>
    <unitModules Name="Workflows" LoadMode="SourceGenerator">
        <dllModule Name="WorkFlow" Dll="WorkFlowCore" Path=".">
            <loadClass Name="WorkFlowCoreModule"/>
        </dllModule>
    </unitModules>
	<unitModules Name="PorocoatCell" LoadMode="SourceGenerator">
		<dllModule Name="PorocoatCell" Dll="PorocoatCellModule" Path=".">
			<loadClass Name="PorocoatCellModule"/>
		</dllModule>
	</unitModules>
</wpfModules>